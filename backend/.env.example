# ─────────────────────────────────────────────────────────────────────────────
# TripleA Backend Environment Configuration
# Copy this file to `backend/.env` and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL / Neon connection string.
#   - Local dev with no TLS  :  postgres://user:password@localhost:5432/triplea
#   - Neon (recommended)    :  from Neon dashboard → Connection string (TLS)
DATABASE_URL=postgres://user:password@localhost:5432/triplea

# ── CORS ─────────────────────────────────────────────────────────────────────
# In production, set this to your deployed frontend URL(s), comma-separated.
# In development, localhost Vite origins are auto-allowed.
FRONTEND_URL=https://your-frontend-domain.com
# CORS_ORIGINS=  # only set this if you need to allow additional origins beyond FRONTEND_URL

# ── Session / Guest Cart ─────────────────────────────────────────────────────
# Guest cart uses an `x-session-id` header generated by the frontend.
# (No server-side SESSION_SECRET is currently required for session management.)
SESSION_SECRET=change_this_to_a_long_random_string

# ── Admin Account ────────────────────────────────────────────────────────────
# Used by scripts/init-db.js and scripts/create-admin.js to seed the initial
# admin user. The password is hashed (bcrypt) before storage.
# Only set RUN_DEMO_SEED=true to seed the database with demo data + admin user.
RUN_DEMO_SEED=false
ADMIN_EMAIL=admin@triplea-supplements.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# ── Email / WhatsApp (Order confirmations) ───────────────────────────────────
WHATSAPP_NUMBER=120123456789
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Used for admin panel authentication tokens.
JWT_SECRET=change_this_to_a_long_random_jwt_secret
JWT_EXPIRES_IN=7d

# ── File Upload ──────────────────────────────────────────────────────────────
# Optional upload directory (must be writable). On Vercel, use an external
# storage provider (e.g. S3) instead.
UPLOAD_DIR=./uploads

# ─────────────────────────────────────────────────────────────────────────────
# TripleA Frontend Environment Configuration
# Copy this file to `frontend/.env` and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Base URL ─────────────────────────────────────────────────────────────
# Must point to your deployed backend API. In production this is typically the
# backend's Vercel domain (no trailing slash). When empty, the API client will
# warn in development and fail gracefully in production.
VITE_API_BASE_URL=https://https://triplea-api.vercel.app/api

# ── Frontend URL ─────────────────────────────────────────────────────────────
# Used for canonical links and SEO. Set to your deployed domain.
VITE_FRONTEND_URL=https://triplea-eight.vercel.app

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Optional ─────────────────────────────────────────────────────────────────
# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=
# WhatsApp number for contact links (used by backend order confirmation;
# mirror here if the frontend displays it directly)
VITE_WHATSAPP_NUMBER=201013606284
